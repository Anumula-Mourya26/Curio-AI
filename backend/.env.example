# ACaaS Backend Environment Variables
# Copy to .env and fill in values

APP_NAME=ACaaS
DEBUG=true
API_PREFIX=/api/v1

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173

# File upload limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# LLM provider (for Hypothesis Generator, Information Seeker, Discovery Engine)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
